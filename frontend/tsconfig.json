{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the browser code, so resolve imports the way a bundler does
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
