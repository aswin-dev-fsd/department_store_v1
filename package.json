{
  "name": "department-store",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud billing, purchase entry and stock management for department-store branches",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:packages": "npm run build -w @ds/shared -w @ds/database",
    "db:generate": "npm run db:generate -w @ds/database",
    "db:migrate": "npm run db:migrate -w @ds/database --",
    "db:check": "npm run db:check -w @ds/database --",
    "check-types": "npm run build:packages && npm run check-types --workspaces --if-present",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
