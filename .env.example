# Copy to .env at the repo root and fill in real values. Never commit .env.
# Validated at startup by backend/src/config/env.schema.ts.

NODE_ENV=development
PORT=4000

# Local PostgreSQL 18 for development and tests (D-33; docs/dev-setup.md section 3)
DATABASE_URL=postgresql://dept_store:PASSWORD@localhost:5432/dept_store_dev
TEST_DATABASE_URL=postgresql://dept_store:PASSWORD@localhost:5432/dept_store_test
# Neon (online) instead — direct, non-pooled strings; swap these in to run the tests online (D-28)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/neondb?sslmode=require&channel_binding=require

# Comma-separated allow-list; required in production, never "*"
CORS_ORIGIN=http://localhost:5173

SESSION_TTL_HOURS=12
# Must be true in production (HTTPS only)
COOKIE_SECURE=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Reverse proxies in front of the API: 0 locally, 2 on staging (Vercel + Render)
TRUST_PROXY=0
