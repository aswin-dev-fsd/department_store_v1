{
  "name": "@ds/database",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, PostgreSQL client and migrations",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:check": "tsx src/check.ts"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "dependencies": {
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  }
}
